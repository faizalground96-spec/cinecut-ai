# Contoh pengaturan CineCut AI — SALIN file ini menjadi .env lalu isi kuncimu.
# JANGAN pernah menaruh API key asli di file ini / di GitHub.
# Dapatkan kunci gratis / berbayar di: https://ai.studio.google.com
GEMINI_API_KEY=
# Model yang dipakai (boleh dibiarkan apa adanya)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Suara cadangan Edge-TTS (id-ID-ArdiNeural = cowok, id-ID-GadisNeural = cewek)
EDGE_TTS_VOICE=id-ID-ArdiNeural
